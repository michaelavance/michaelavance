resIGFDF$diffexpressed[resIGFDF$log2FoldChange < -0.585 & resIGFDF$padj < 0.05] <- "Downregulated"

#make volcano plot
vp1 <- ggplot(data = resIGFDF, aes(x = log2FoldChange, y = -log10(padj), col = diffexpressed)) +
